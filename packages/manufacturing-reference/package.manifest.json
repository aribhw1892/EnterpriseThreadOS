{
  "packageKey": "etos-manufacturing-reference",
  "name": "ETOS Manufacturing Reference Package",
  "versionLabel": "1.0.0",
  "summary": "Reference manufacturing ontology, import/query profiles, and governed artifact seeds for local demo flows.",
  "ontology": {
    "key": "etos-manufacturing-ontology",
    "versionLabel": "1.0.0",
    "summary": "Manufacturing parts, documents, changes, and BOM relationships.",
    "objectTypesFile": "ontology/object-types.json",
    "relationshipTypesFile": "ontology/relationships.json",
    "bomRelationshipsFile": "ontology/bom-relationships.json"
  },
  "semanticLayer": {
    "key": "etos-manufacturing-semantic",
    "versionLabel": "1.0.0",
    "summary": "Graph memory naming for manufacturing objects and BOM edges."
  },
  "lifecycle": {
    "key": "etos-manufacturing-lifecycle",
    "versionLabel": "1.0.0",
    "summary": "Manufacturing lifecycle normalization vocabulary."
  },
  "attributeSchema": {
    "key": "etos-manufacturing-attributes",
    "versionLabel": "1.0.0",
    "summary": "Tenant-safe canonical attributes for manufacturing imports."
  },
  "profiles": {
    "importProfileFile": "profiles/import-profile.json",
    "pdmImportMappingsFile": "profiles/pdm-import-mappings.json",
    "odooImportMappingsFile": "profiles/odoo-import-mappings.json",
    "queryIntentExtensionsFile": "profiles/query-intent-extensions.json",
    "identityResolutionRulesFile": "profiles/identity-resolution-rules.json"
  },
  "importSources": [
    {
      "slug": "pdm",
      "title": "SolidWorks PDM",
      "sourceSystem": "SOLIDWORKS-PDM",
      "mappingsFile": "profiles/pdm-import-mappings.json",
      "demoImportDir": "demo-imports/pdm",
      "helpersManifestPath": "ETOS.Helpers/PdmTransform/etos_import/manifest.json",
      "runbook": {
        "extractReadme": "ETOS.Helpers/PdmExtractor/README.md",
        "transformReadme": "ETOS.Helpers/PdmTransform/README.md"
      }
    },
    {
      "slug": "odoo",
      "title": "Odoo ERP",
      "sourceSystem": "ODOO-ERP",
      "mappingsFile": "profiles/odoo-import-mappings.json",
      "demoImportDir": "demo-imports/odoo",
      "helpersManifestPath": "ETOS.Helpers/OdooErpTransform/etos_import/manifest.json",
      "runbook": {
        "extractReadme": "ETOS.Helpers/OdooErpExtractor/README.md",
        "transformReadme": "ETOS.Helpers/OdooErpTransform/README.md"
      }
    }
  ],
  "demoImports": {
    "flatPartImportFile": "demo-imports/flat-part-import.csv",
    "bomComparisonFile": "demo-imports/bom-comparison.csv"
  },
  "artifacts": {
    "capabilitiesFile": "artifacts/capabilities.json",
    "businessPoliciesFile": "artifacts/business-policies.json",
    "optimizationModelsFile": "artifacts/optimization-models.json",
    "agentTemplatesFile": "artifacts/agent-templates.json",
    "toolsFile": "artifacts/tools.json",
    "connectorsFile": "artifacts/connectors.json",
    "skillsFile": "artifacts/skills.json",
    "workflowsFile": "artifacts/workflows.json"
  }
}
