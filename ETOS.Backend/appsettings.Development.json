{
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "DigitalThread": {
    "UseLiveProjection": false
  },
  "Infrastructure": {
    "ProbeTimeoutMilliseconds": 500
  },
  "SeedIdentity": {
    "Enabled": true,
    "AdminUserId": "11111111-1111-1111-1111-111111111111",
    "AdminEmail": "admin@etos.com",
    "AdminPassword": "admin-password",
    "TenantId": "22222222-2222-2222-2222-222222222222",
    "TenantIdentifier": "local",
    "TenantName": "Local Tenant"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ImportMappingSuggestions": {
    "DefaultProviderKey": "pydantic-ai-v1",
    "Enabled": true,
    "MappingAssistantAgentKey": "import-mapping-assistant",
    "FallbackToRuleBasedOnRuntimeFailure": true
  },
  "DocumentVectorIndexing": {
    "Enabled": true,
    "Embedding": {
      "Provider": "openai-compatible",
      "Model": "text-embedding-nomic-embed-text-v1.5",
      "Dimensions": 768,
      "BaseUrl": "http://localhost:1234/v1"
    }
  }
}
