{
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Infrastructure": {
    "ProbeTimeoutMilliseconds": 500
  },
  "SeedIdentity": {
    "Enabled": true,
    "AdminUserId": "11111111-1111-1111-1111-111111111111",
    "AdminEmail": "admin@etos.com",
    "AdminPassword": "admin-password",
    "TenantId": "22222222-2222-2222-2222-222222222222",
    "TenantIdentifier": "local",
    "TenantName": "Local Tenant"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ImportMappingSuggestions": {
    "DefaultProviderKey": "pydantic-ai-v1",
    "Enabled": true,
    "PrimaryModelProviderKey": "openai-compatible",
    "PrimaryModelId": "local-model",
    "FallbackModels": [
      {
        "ProviderKey": "openai",
        "ModelId": "gpt-4o-mini",
        "TriggerReason": "local unavailable"
      }
    ],
    "FallbackToRuleBasedOnRuntimeFailure": true,
    "PrefetchToolEnabled": true,
    "PrefetchToolKey": "mapping-predictor-tool"
  }
}
